"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" => llm-suggest：根据选中文段和给定要求给出修改思路、词汇备选和最优文段
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" 用法:
"   :'<,'>LlmSuggest [要求]      根据选中的文段和要求给出修改建议
"   :LlmSuggest [要求]           针对当前行（或选区）给出修改建议
"   :LlmSuggestSentence [要求]   针对当前行给出修改建议
"   :LlmSuggestParagraph [要求]  针对当前段落给出修改建议
" 快捷键:
"   <Leader>lg (Visual) 选中文字后按，提示输入要求并流式输出建议
"   <Leader>lg (Normal) 当前行触发，提示输入要求并流式输出建议
"   <Leader>lG (Normal) 当前段触发，提示输入要求并流式输出建议
"   <Leader>li / <Leader>lI 别名同上
"

let s:suggest_model = get(g:, 'llm_suggest_model', s:model)
let s:suggest_tmpl = get(g:, 'llm_suggest_template',
      \ expand('~') . '/.config/pi/agent/prompts/suggest.md')
let s:suggest_directive = get(g:, 'llm_suggest_directive',
      \ '立即直接对输入的内容执行修改与优化任务并输出，不要提问、不要反问、不要寒暄。')

let s:suggest_bnum = -1
let s:suggest_job = v:null
let s:suggest_first_line = v:true

function! s:llm_suggest_build_cmd(lines, requirement) abort
  let l:tmp = tempname()
  call writefile(a:lines, l:tmp)
  let l:msg = s:suggest_directive
  if a:requirement !=# ''
    let l:msg = '【要求】' . a:requirement . '。' . l:msg
  endif
  let l:cmd = printf('cat %s | %s prompt --sf %s -m %s -s %s; rm -f %s',
        \ shellescape(l:tmp), shellescape(s:llm), shellescape(s:suggest_tmpl),
        \ shellescape(s:suggest_model), shellescape(l:msg), shellescape(l:tmp))
  return l:cmd
endfunction

function! s:llm_suggest_out_cb(ch, msg) abort
  if s:suggest_bnum <= 0 || !bufexists(s:suggest_bnum) | return | endif
  if s:suggest_first_line
    let s:suggest_first_line = v:false
    call deletebufline(s:suggest_bnum, 1, '$')
    call setbufline(s:suggest_bnum, 1, a:msg)
  else
    call appendbufline(s:suggest_bnum, '$', a:msg)
  endif
endfunction

function! s:llm_suggest_ensure_output(label) abort
  if s:suggest_bnum > 0 && bufexists(s:suggest_bnum)
    let l:wins = win_findbuf(s:suggest_bnum)
    if !empty(l:wins)
      call win_gotoid(l:wins[0])
    else
      execute 'botright sbuffer ' . s:suggest_bnum
    endif
  else
    botright new
    setlocal buftype=nofile bufhidden=wipe noswapfile
    setlocal filetype=markdown
    let s:suggest_bnum = bufnr('%')
    nnoremap <buffer> <silent> a :call <SID>interactive_suggest_ask()<CR>
    nnoremap <buffer> <silent> <Leader>a :call <SID>interactive_suggest_ask()<CR>
  endif
  call deletebufline(s:suggest_bnum, 1, '$')
  call setbufline(s:suggest_bnum, 1, ['… llm 正在分析并生成修改建议，等待输出 …'])
  call setwinvar(win_getid(), '&statusline', ' llm-suggest[' . a:label . '] (按 a 或 ,a 追问) ')
endfunction

function! s:llm_suggest_start(lines, requirement, label) abort
  if s:suggest_job != v:null
    try | call job_stop(s:suggest_job) | catch | endtry
  endif
  let s:suggest_first_line = v:true
  let l:cmd = s:llm_suggest_build_cmd(a:lines, a:requirement)
  call s:llm_suggest_ensure_output(a:label)
  let s:suggest_job = job_start(['sh', '-c', l:cmd], {
        \ 'out_cb': function('s:llm_suggest_out_cb'),
        \ 'close_cb': function('s:on_suggest_job_close'),
        \ })
endfunction

function! s:on_suggest_job_close(ch) abort
  let s:suggest_job = v:null
endfunction

function! s:on_ask_job_close(ch) abort
  let s:suggest_job = v:null
endfunction

let s:ask_first_line = v:true

function! s:on_ask_stream(ch, msg) abort
  if s:suggest_bnum <= 0 || !bufexists(s:suggest_bnum) | return | endif
  if s:ask_first_line
    let s:ask_first_line = v:false
    call setbufline(s:suggest_bnum, '$', a:msg)
  else
    call appendbufline(s:suggest_bnum, '$', a:msg)
  endif
  let l:wins = win_findbuf(s:suggest_bnum)
  if !empty(l:wins)
    call win_execute(l:wins[0], 'normal! G')
  endif
endfunction

function! LlmSuggestAsk(...) abort
  let l:question = a:0 ? join(a:000, ' ') : ''
  if empty(l:question)
    let l:question = input('追问 (Follow up): ')
  endif
  if empty(l:question) | return | endif

  if s:suggest_job != v:null
    try | call job_stop(s:suggest_job) | catch | endtry
  endif

  if s:suggest_bnum <= 0 || !bufexists(s:suggest_bnum)
    echo '未找到活跃的 suggestion 窗口'
    return
  endif

  let l:wins = win_findbuf(s:suggest_bnum)
  if empty(l:wins)
    execute 'botright sbuffer ' . s:suggest_bnum
  endif

  call appendbufline(s:suggest_bnum, '$', ['', '---', '### 追问: ' . l:question, '', '… 正在思考并回答 …'])
  let l:wins = win_findbuf(s:suggest_bnum)
  if !empty(l:wins)
    call win_execute(l:wins[0], 'normal! G')
  endif

  let s:ask_first_line = v:true
  let l:tmp = tempname()
  call writefile([l:question], l:tmp)
  let l:cmd = printf('cat %s | %s prompt -c; rm -f %s', shellescape(l:tmp), shellescape(s:llm), shellescape(l:tmp))
  let s:suggest_job = job_start(['sh', '-c', l:cmd], {
        \ 'out_cb': function('s:on_ask_stream'),
        \ 'err_cb': function('s:on_ask_stream'),
        \ 'close_cb': function('s:on_ask_job_close'),
        \ })
endfunction

function! s:interactive_suggest_ask() abort
  let l:q = input('追问 (Follow up): ')
  if empty(l:q) | return | endif
  call LlmSuggestAsk(l:q)
endfunction

function! LlmSuggestSentence(...) abort
  let l:req = a:0 ? a:1 : ''
  call s:llm_suggest_start([getline('.')], l:req, '句')
endfunction

function! LlmSuggestParagraph(...) abort
  let l:req = a:0 ? a:1 : ''
  let l:s = line('.')
  let l:e = l:s
  while l:e < line('$') && getline(l:e + 1) !~# '^\s*$'
    let l:e += 1
  endwhile
  call s:llm_suggest_start(getline(l:s, l:e), l:req, '段')
endfunction

function! LlmSuggestRange(line1, line2, ...) abort
  let l:req = a:0 ? a:1 : ''
  call s:llm_suggest_start(getline(a:line1, a:line2), l:req, '选区')
endfunction

function! s:interactive_suggest_visual() abort
  let l:sel = GetVisualSelection()
  let l:lines = split(l:sel, "\n")
  if empty(l:lines)
    let l:lines = [getline('.')]
  endif
  let l:req = input('修改要求 (回车跳过): ')
  call s:llm_suggest_start(l:lines, l:req, '选区')
endfunction

function! s:interactive_suggest_normal() abort
  let l:req = input('修改要求 (回车跳过): ')
  call s:llm_suggest_start([getline('.')], l:req, '句')
endfunction

function! s:interactive_suggest_paragraph() abort
  let l:req = input('修改要求 (回车跳过): ')
  call LlmSuggestParagraph(l:req)
endfunction

" 命令与映射
command! -range -nargs=? LlmSuggest          if <line1> == <line2> && <q-args> ==# '' | call <SID>interactive_suggest_normal() | else | call LlmSuggestRange(<line1>, <line2>, <q-args>) | endif
command! -range -nargs=? LlmSuggestSelection <line1>,<line2>call LlmSuggestRange(<line1>, <line2>, <q-args>)
command! -nargs=?        LlmSuggestSentence  call LlmSuggestSentence(<q-args>)
command! -nargs=?        LlmSuggestParagraph call LlmSuggestParagraph(<q-args>)
command! -nargs=*        LlmSuggestAsk       call LlmSuggestAsk(<f-args>)

" 快捷键：
" Visual 模式：选中文字后按 <Leader>lg，提示输入修改要求（可直接回车），分屏流式输出
vnoremap <silent> <Leader>ls :<C-u>call <SID>interactive_suggest_visual()<CR>

" Normal 模式：按 <Leader>lg 对当前行触发修改建议
nnoremap <silent> <Leader>ls :call <SID>interactive_suggest_normal()<CR>
