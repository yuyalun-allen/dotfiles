" => Visual 模式下按 <Leader>s 按中英文句号分行（语义分句）
function! s:split_sentences_visual() abort
  let l:saved_reg = @@
  let l:saved_type = getregtype('@')

  " 获取选区内容
  let l:text = GetVisualSelection()
  if empty(l:text) | return | endif

  " 1. 中文句号：替换为句号 + 换行
  let l:text = substitute(l:text, '。\s*', "。\n", 'g')
  " 2. 英文句号：仅在句号后有空白字符时替换为句号 + 换行（避免误伤 3.14 等数字）
  let l:text = substitute(l:text, '\.\s\+', ".\n", 'g')
  " 3. 清理末尾可能多出的空换行
  let l:text = substitute(l:text, '\n\+$', '', '')

  " 替换选区内容并保持寄存器干净
  call setreg('"', l:text, 'c')
  normal! gvp

  let @@ = l:saved_reg
  call setreg('@', l:saved_reg, l:saved_type)
endfunction

vnoremap <silent> <Leader>s :<C-u>call <SID>split_sentences_visual()<CR>


"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" => llm-review：在 vim 中调用 llm 复盘当前内容
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" 用法:
"   :LlmReview              复盘整个 buffer（chapter，流式输出到下方窗口）
"   :LlmReviewSentence      复盘当前行（微距）
"   :LlmReviewParagraph     复盘当前段（到下个空行，中距）
"   :LlmReviewChapter       复盘整个 buffer（宏观）
"   :LlmReviewFocus <词>    复盘整个 buffer 并重点关注某方面
"   :'<,'>LlmReviewSelection 复盘显式选中的内容
" 依赖: llm 在 PATH 中；三个粒度分别用不同的 prompt template
" 行为: 内容写临时文件 -> 管道给 `llm prompt --sf <tmpl> -m <model> -s <directive>`
"       -> 后台 job 实时接收行输出并直接渲染到 buffer
"

let s:llm = get(g:, 'llm_executable', 'llm')
let s:model = get(g:, 'llm_review_model', 'gemini-3.5-flash-lite')
" let s:model = get(g:, 'llm_review_model', 'llama-local')
" 三个粒度的提示词模板：sentence(当前行) / paragraph(到下个空行) / chapter(整个buffer)
let s:tmpls = {
      \ 'sentence': get(g:, 'llm_review_sentence_template',
      \   expand('~') . '/.config/pi/agent/prompts/review-sentence.md'),
      \ 'paragraph': get(g:, 'llm_review_paragraph_template',
      \   expand('~') . '/.config/pi/agent/prompts/review-paragraph.md'),
      \ 'chapter': get(g:, 'llm_review_chapter_template',
      \   expand('~') . '/.config/pi/agent/prompts/review.md'),
      \ }
let s:labels = {'sentence': '句', 'paragraph': '段', 'chapter': '篇'}
let s:directive = get(g:, 'llm_review_directive',
      \ '立即直接对输入的内容执行复盘任务并输出，不要提问、不要反问、不要寒暄。')

" 运行时状态
let s:bnum = -1       " 输出 buffer 号
let s:job = v:null
let s:first_line = v:true

" 命令构建：内容 -> 临时文件 -> 管道给 llm；结束后清理临时文件
function! s:llm_build_cmd(lines, focus, tmpl) abort
  let l:tmp = tempname()
  call writefile(a:lines, l:tmp)
  let l:msg = s:directive
  if a:focus !=# ''
    let l:msg = '【关注点】' . a:focus . '。' . l:msg
  endif
  let l:cmd = printf('cat %s | %s prompt --sf %s -m %s -s %s; rm -f %s',
        \ shellescape(l:tmp), shellescape(s:llm), shellescape(a:tmpl),
        \ shellescape(s:model), shellescape(l:msg), shellescape(l:tmp))
  return l:cmd
endfunction

" 实时按行追加到输出 buffer
function! s:llm_out_cb(ch, msg) abort
  if s:bnum <= 0 || !bufexists(s:bnum) | return | endif
  if s:first_line
    let s:first_line = v:false
    call deletebufline(s:bnum, 1, '$')
    call setbufline(s:bnum, 1, a:msg)
  else
    call appendbufline(s:bnum, '$', a:msg)
  endif
endfunction

" 复用或新建输出窗口
function! s:llm_ensure_output(label) abort
  if s:bnum > 0 && bufexists(s:bnum)
    let l:wins = win_findbuf(s:bnum)
    if !empty(l:wins)
      call win_gotoid(l:wins[0])
    else
      execute 'botright sbuffer ' . s:bnum
    endif
  else
    botright new
    setlocal buftype=nofile bufhidden=wipe noswapfile
    setlocal filetype=markdown
    let s:bnum = bufnr('%')
  endif
  call deletebufline(s:bnum, 1, '$')
  call setbufline(s:bnum, 1, ['… llm 正在复盘，等待输出 …'])
  call setwinvar(win_getid(), '&statusline', ' llm-review[' . a:label . '] ')
endfunction

function! s:llm_start(lines, focus, gran) abort
  if s:job != v:null
    try | call job_stop(s:job) | catch | endtry
  endif
  let s:first_line = v:true
  let l:tmpl = get(s:tmpls, a:gran, s:tmpls['chapter'])
  let l:cmd = s:llm_build_cmd(a:lines, a:focus, l:tmpl)
  call s:llm_ensure_output(get(s:labels, a:gran, a:gran))
  let s:job = job_start(['sh', '-c', l:cmd], {'out_cb': function('s:llm_out_cb')})
endfunction

" 公开函数（三粒度，均支持传入关注点 focus）
" sentence：当前行
function! LlmReviewSentence(...) abort
  let l:focus = a:0 ? a:1 : ''
  call s:llm_start([getline('.')], l:focus, 'sentence')
endfunction
" paragraph：当前行到下个空行之前
function! LlmReviewParagraph(...) abort
  let l:focus = a:0 ? a:1 : ''
  let l:s = line('.')
  let l:e = l:s
  while l:e < line('$') && getline(l:e + 1) !~# '^\s*$'
    let l:e += 1
  endwhile
  call s:llm_start(getline(l:s, l:e), l:focus, 'paragraph')
endfunction
" chapter：整个 buffer
function! LlmReviewChapter(...) abort
  let l:focus = a:0 ? a:1 : ''
  call s:llm_start(getline(1, '$'), l:focus, 'chapter')
endfunction
function! LlmReviewFocus(...) abort
  let l:focus = a:0 ? join(a:000, ' ') : ''
  call s:llm_start(getline(1, '$'), l:focus, 'chapter')
endfunction
" 显式选中内容：单行用 sentence(微距)，多行用 paragraph(中距)
function! LlmReviewSelection(...) range abort
  let l:focus = a:0 ? a:1 : ''
  if a:firstline == a:lastline
    call s:llm_start(getline(a:firstline, a:lastline), l:focus, 'sentence')
  else
    call s:llm_start(getline(a:firstline, a:lastline), l:focus, 'paragraph')
  endif
endfunction

function! s:interactive_review_visual() abort
  let [l:line_start, l:line_end] = [getpos("'<")[1], getpos("'>")[1]]
  let l:focus = input('关注点/Review Focus (回车跳过): ')
  if l:line_start == l:line_end
    call s:llm_start([getline(l:line_start)], l:focus, 'sentence')
  else
    call s:llm_start(getline(l:line_start, l:line_end), l:focus, 'paragraph')
  endif
endfunction

function! s:interactive_review_normal() abort
  let l:focus = input('关注点/Review Focus (回车跳过): ')
  call LlmReviewChapter(l:focus)
endfunction

" 命令与映射
command! -nargs=?        LlmReview          call LlmReviewChapter(<q-args>)
command! -nargs=?        LlmReviewChapter   call LlmReviewChapter(<q-args>)
command! -nargs=?        LlmReviewSentence  call LlmReviewSentence(<q-args>)
command! -nargs=?        LlmReviewParagraph call LlmReviewParagraph(<q-args>)
command! -nargs=*        LlmReviewFocus     call LlmReviewFocus(<f-args>)
command! -range -nargs=? LlmReviewSelection <line1>,<line2>call LlmReviewSelection(<q-args>)

