" => Wayland clipboard via wl-clipboard (from :help wayland)
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" 当 compositor 不支持 wlr-data-control/ext-data-control 协议时，
" 通过 wl-copy/wl-paste 实现系统剪贴板（GNOME/Mutter 需要此项）
" TO BE DONE
function! GetVisualSelection()
 let [line_start, col_start] = getpos("'<")[1:2]
 let [line_end,   col_end]   = getpos("'>")[1:2]
 let lines = getline(line_start, line_end)
 if empty(lines)
   return ''
 endif
 " 截掉首行之前和末行之后多余的部分，保留字符级选区
 let lines[-1] = lines[-1][: col_end - (&selection == 'inclusive' ? 1 : 2)]
 let lines[0]  = lines[0][col_start - 1:]
 return join(lines, "\n")
endfunction

