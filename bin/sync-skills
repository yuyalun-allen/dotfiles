#!/usr/bin/env bash
set -euo pipefail

DOTFILES_SKILLS="$HOME/dotfiles/tools/pi/agent/skills"
DOTFILES_MODES="$HOME/dotfiles/tools/pi/agent/modes"
CLAUDE_SYNCED_BASE="$HOME/.claude/skills/synced"

# 1. 动态找到 Claude Code 的最新同步目录 (无需硬编码 UUID)
LATEST_CLAUDE_DIR=$(find "$CLAUDE_SYNCED_BASE" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n 1 || true)

if [ -n "$LATEST_CLAUDE_DIR" ] && [ -d "$LATEST_CLAUDE_DIR" ]; then
    echo "▶ 从 Claude Code 同步基础技能: $LATEST_CLAUDE_DIR -> $DOTFILES_SKILLS / $DOTFILES_MODES"

    # 通用 skills 保留在 skills/，模式专属 skills 同步至各 modes/<mode>/skills/
    sync_skill_to_dest() {
        local skill="$1" dest="$2"
        if [ -d "$LATEST_CLAUDE_DIR/$skill" ]; then
            echo "  - 同步 $skill -> $dest"
            mkdir -p "$dest/$skill"
            rsync -a --delete \
                --exclude='__pycache__' \
                --exclude='*.pyc' \
                "$LATEST_CLAUDE_DIR/$skill/" "$dest/$skill/"
        fi
    }

    # office mode skills
    for s in docx pptx xlsx pdf; do
        sync_skill_to_dest "$s" "$DOTFILES_MODES/office/skills"
    done

    # pi-dev mode skill
    sync_skill_to_dest "skill-creator" "$DOTFILES_MODES/pi-dev/skills"

    # general skills
    sync_skill_to_dest "deep-research" "$DOTFILES_SKILLS"
else
    echo "ℹ 未检测到 Claude Code 的 synced skills 目录，跳过核心技能同步。"
fi

# 2. 同步官方插件市场的高质量技能
PLUGIN_SKILLS_BASE="$HOME/.claude/plugins/marketplaces/claude-plugins-official"
if [ -d "$PLUGIN_SKILLS_BASE" ]; then
    echo "▶ 从 Claude Plugins 市场同步插件技能..."
    PLUGINS_TO_SYNC=(
        "frontend-design:frontend-design/skills/frontend-design:$DOTFILES_MODES/frontend/skills"
    )
    for item in "${PLUGINS_TO_SYNC[@]}"; do
        IFS=':' read -r name subpath target_dir <<< "$item"
        src="$PLUGIN_SKILLS_BASE/plugins/$subpath"
        if [ -d "$src" ]; then
            echo "  - 同步 $name -> $target_dir..."
            mkdir -p "$target_dir/$name"
            rsync -a --delete \
                --exclude='__pycache__' \
                --exclude='*.pyc' \
                "$src/" "$target_dir/$name/"
        fi
    done
fi

# 3. 同步 google-colab-cli 自带的 colab-operator 技能 (experiment mode)
COLAB_SKILL_SRC=$(find "$HOME/.local/share/pipx/venvs/google-colab-cli" -name "SKILL.md" 2>/dev/null | head -n 1 || true)
if [ -n "$COLAB_SKILL_SRC" ] && [ -f "$COLAB_SKILL_SRC" ]; then
    echo "▶ 从 google-colab-cli 同步技能..."
    echo "  - 同步 colab-operator -> $DOTFILES_MODES/experiment/skills..."
    mkdir -p "$DOTFILES_MODES/experiment/skills/colab-operator"
    cp -u "$COLAB_SKILL_SRC" "$DOTFILES_MODES/experiment/skills/colab-operator/SKILL.md"
fi

echo "✔ 技能同步检查完毕！可通过 'git -C ~/dotfiles diff' 查看变更。"
